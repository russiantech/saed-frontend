server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 520m;          # >= SAED_MAX_VIDEO_BYTES

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Deployment settings and the HTML shell must never be cached; hashed assets can be cached for a year.
    location = /config.js   { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location = /index.html  { add_header Cache-Control "no-cache"; }
    location = /sw.js       { add_header Cache-Control "no-cache"; add_header Service-Worker-Allowed "/"; try_files $uri =404; }
    location = /manifest.webmanifest { add_header Cache-Control "no-cache"; default_type application/manifest+json; try_files $uri =404; }
    location = /offline.html { add_header Cache-Control "no-cache"; }
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }

    # Same-origin mode (VITE_API_URL=/api): API + docs + admin go to the Django backend (separate repo/container).
    # API_UPSTREAM and DNS_RESOLVER are filled in from the container environment at start-up.
    # Using a variable keeps nginx from failing to boot when the backend is not resolvable yet, or when the
    # SPA is deployed on its own and calls the API directly on another host (VITE_API_URL=https://api.example.com/api).
    resolver ${DNS_RESOLVER} valid=30s ipv6=off;
    location ~ ^/(api|admin|docs|redoc|static)/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_request_buffering off;    # stream video uploads
        proxy_buffering off;            # stream video downloads / Range
    }
    location = /docs { return 302 /api/docs/; }
    # NOTE: lesson media is private and streamed by Django at /api/lessons/<id>/media/<kind>/.
    # /protected_media is deliberately NOT served by nginx.

    location / { try_files $uri /index.html; }
}
