# Frontend environment. Only VITE_* variables reach the browser; never put secrets here.
# Copy to .env (or .env.development / .env.production). Vite picks the file by mode:
#   npm run dev   -> .env.development      npm run build -> .env.production
#
# API address fallback. Normally leave this alone: the address is chosen per host name from
# public/config.js (API_URLS), which can be edited on the server after the build. Used only if the
# host is not listed there.  Same origin: /api    Different host: https://saed-api.example.com/api
VITE_API_URL=/api
# Where the Vite dev/preview server proxies /api and /media (development only).
VITE_BACKEND_URL=http://127.0.0.1:8002

# Logo shown in the sidebar, public nav and auth pages (file lives in frontend/public/).
VITE_LOGO_URL=/logo.png
