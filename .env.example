# Frontend environment (copy to .env). Only VITE_* variables reach the browser; never put secrets here.
# API base used by the browser. Keep "/api" (same-origin; the dev server and nginx proxy it to Django).
VITE_API_URL=/api
# Where the Vite dev/preview server proxies /api and /media (development only).
VITE_BACKEND_URL=http://127.0.0.1:8002

# Logo shown in the sidebar, public nav and auth pages (file lives in frontend/public/).
VITE_LOGO_URL=/logo.png
