# Frontend environment (copy to .env, or .env.production for `npm run build`). Only VITE_* variables reach the
# browser; never put secrets here.
#
# API address used by the browser.
#   • Same origin (dev server / nginx proxy): /api
#   • Frontend and API on different hosts (production, cPanel):  https://saed-api.example.com/api
# You can ALSO set/override it after building by editing  config.js  in the deployed folder (no rebuild).
VITE_API_URL=/api
# Where the Vite dev/preview server proxies /api and /media (development only).
VITE_BACKEND_URL=http://127.0.0.1:8002

# Logo shown in the sidebar, public nav and auth pages (file lives in frontend/public/).
VITE_LOGO_URL=/logo.png
