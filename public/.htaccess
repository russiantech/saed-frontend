# Apache / cPanel: serve the single-page app. Real files (assets, config.js) are served as they are;
# every other path falls back to index.html so deep links like /login or /app/courses work on refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # Backend-style paths must never be answered with the web page: a request that reaches this host by mistake
  # (wrong API address) should fail loudly with 404, not return HTML that looks like a response.
  RewriteRule ^(api|media|admin|docs|redoc|static)/ - [R=404,L]
  # Missing files (images, scripts, ...) are real 404s too - only extension-less paths are app routes.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,6}$
  RewriteRule . /index.html [L]
</IfModule>
# Always re-check the deployment settings and the HTML shell; hashed assets can be cached for a year.
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  # the service worker, manifest, offline page, deployment settings and HTML shell must always be re-checked
  <FilesMatch "^(config\.js|index\.html|sw\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/#"
  </FilesMatch>
</IfModule>
